-- ESP labels
local espFolder = Instance.new("Folder")
espFolder.Name = "JeanPanotESP"
espFolder.Parent = gui

local espGuis = {}

local function removeESP(p)
    if espGuis[p] then
        espGuis[p]:Destroy()
        espGuis[p] = nil
    end
end

local function makeESP(p)
    removeESP(p)
    if p == player or not p.Character then return end

    local head = p.Character:FindFirstChild("Head")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(210, 45)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 500000
    billboard.Enabled = false
    billboard.Parent = espFolder

    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0.2
    text.Font = Enum.Font.GothamBold
    text.TextSize = 12
    text.Parent = billboard

    espGuis[p] = billboard
end

local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if not espGuis[p] then makeESP(p) end

            local bill = espGuis[p]
            if bill and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if head and hum then
                    bill.Adornee = head
                    bill.Enabled = espOn and not isExcluded(p)

                    local tool = p.Character:FindFirstChildOfClass("Tool")
                    local labelText = bill:FindFirstChildOfClass("TextLabel")
                    if labelText then
                        labelText.Text = p.Name
                            .. "\nHP: " .. math.floor(hum.Health)
                            .. " | Weapon: " .. (tool and tool.Name or "None")
                    end
                else
                    bill.Enabled = false
                end
            end
        end
    end
end

local function visible(character)
    local camera = workspace.CurrentCamera
    local head = character and character:FindFirstChild("Head")
    if not camera or not head then return false end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character, camera}

    local origin = camera.CFrame.Position
    local result = workspace:Raycast(origin, head.Position - origin, params)
    return result ~= nil and result.Instance:IsDescendantOf(character)
end

local function findTarget()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local center = camera.ViewportSize / 2
    local best, bestDistance = nil, radius

    for _, p in ipairs(Players:GetPlayers()) do
        if not isExcluded(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local point, onScreen = camera:WorldToViewportPoint(head.Position)
                local dist = (Vector2.new(point.X, point.Y) - center).Magnitude

                if onScreen and dist < bestDistance
                    and (not wallOn or visible(p.Character)) then
                    best = p
                    bestDistance = dist
                end
            end
        end
    end
    return best
end

for _, p in ipairs(Players:GetPlayers()) do
