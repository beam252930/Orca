-- Local visual simplification with restore
local function simplify(obj)
    if obj:IsA("Decal") or obj:IsA("Texture") then
        if saved[obj] == nil then saved[obj] = obj.Transparency end
        obj.Transparency = 1
    elseif obj:IsA("MeshPart") then
        if saved[obj] == nil then saved[obj] = obj.TextureID end
        obj.TextureID = ""
    elseif obj:IsA("SpecialMesh") then
        if saved[obj] == nil then saved[obj] = obj.TextureId end
        obj.TextureId = ""
    end
end

local function setNoLag(on)
    noLagOn = on
    if on then
        for _, obj in ipairs(workspace:GetDescendants()) do
            pcall(simplify, obj)
        end
    else
        for obj, value in pairs(saved) do
            if obj and obj.Parent then
                pcall(function()
                    if obj:IsA("Decal") or obj:IsA("Texture") then
                        obj.Transparency = value
                    elseif obj:IsA("MeshPart") then
                        obj.TextureID = value
                    elseif obj:IsA("SpecialMesh") then
                        obj.TextureId = value
                    end
                end)
            end
        end
        table.clear(saved)
    end
end

