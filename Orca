local function teammate(p)
    return player.Team ~= nil and p.Team == player.Team
end

local function isExcluded(p)
    return p == player or teammate(p) or excluded[p.UserId] == true
end

local function refreshPlayers()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local status
            if teammate(p) then
                status = "[TEAM]"
            elseif excluded[p.UserId] then
                status = "[EXCLUDED]"
            else
                status = "[INCLUDED]"
            end

            local row = button(playerList, p.Name .. "  " .. status, 28)
            row.TextSize = 11
            row.LayoutOrder = #playerList:GetChildren()

            row.MouseButton1Click:Connect(function()
                selected = p

                if teammate(p) then
                    playerTitle.Text = p.Name .. " is automatically excluded"
                    return
                end

                excluded[p.UserId] = not excluded[p.UserId] or nil
                playerTitle.Text = "Players — tap to exclude/include"
                refreshPlayers()
            end)
        end
    end
end

